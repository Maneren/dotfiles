[init]
	defaultBranch = main
[core]
  compression = 9
  whitespace = error
  preloadindex = true
	excludesFile = ~/.config/git/ignore
	eol = lf
	pager = delta

[interactive]
  diffFilter = delta

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[pull]
	rebase = true
  autoStash = true
[push]
	autoSetupRemote = true
	followTags = true

[rebase]
  autoStash = true
  missingCommitsCheck = warn

[commit]
	gpgsign = true

[url "git@github.com:"]
  pushInsteadOf = https://github.com/
  pushInsteadOf = git://github.com/

[submodule]
  recurse = true

[log]
  abbrevCommit = true

[diff]
  algorithm = histogram
  renames = copies
  colorMoved = true

[delta]
  navigate = true
  hyperlinks = true
  line-numbers-left-format = {nm:^3}
  features = catppuccin-mocha
  hunk-header-style = omit
  file-decoration-style = box

[merge]
	conflictStyle = zdiff3

[include]
    path = ~/.config/delta/themes/catppuccin.gitconfig
